# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID, from the same Developer Portal page
CLIENT_ID=

# Optional: register slash commands to a single guild for instant updates during dev.
# Leave blank to register globally (takes up to ~1 hour to propagate).
GUILD_ID=

# Channel ID where members post their check-ins (right-click channel -> Copy Channel ID)
CHECKIN_CHANNEL_ID=

# Channel ID where weekly recaps and level-up announcements are posted.
# Defaults to CHECKIN_CHANNEL_ID if left blank.
ANNOUNCE_CHANNEL_ID=

# Weekly goal in minutes
WEEKLY_GOAL_MINUTES=180

# Cron schedule (server time) for the weekly recap + reset. Default: Sunday 20:00.
WEEKLY_RECAP_CRON=0 20 * * 0

# IANA timezone for the cron schedule and week boundaries
TIMEZONE=Asia/Kuala_Lumpur

# Path to the SQLite database file. On Railway, point this at a mounted volume, e.g. /data/180moves.db
DATABASE_PATH=./data/180moves.db
